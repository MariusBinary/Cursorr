<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mouseButtonRipple">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/mouseButtonBgStart"
                android:endColor="@color/mouseButtonBgEnd"
                android:angle="0"/>
            <corners android:radius="8sp"/>
            <padding android:bottom="16dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/mouseButtonBgStart"
                android:endColor="@color/mouseButtonBgEnd"
                android:angle="0"/>
            <corners android:radius="8sp"/>
        </shape>
    </item>
</ripple>