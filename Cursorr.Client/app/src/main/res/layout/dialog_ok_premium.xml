<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">

        <ImageView
            android:id="@+id/img_success"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/layout_device_round"
            android:backgroundTint="#4C4CAF50"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:src="@drawable/sharp_check_circle_24" />

        <TextView
            android:id="@+id/premium_description2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/img_success"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Your purchase was successful. Thank you for becoming a Cursorr premium user"
            android:textColor="@color/appForeground" />

        <View
            android:id="@+id/space"
            android:layout_width="wrap_content"
            android:layout_height="2dp"
            android:layout_below="@id/premium_description2"
            android:background="@color/itemDeviceDividerDark" />

        <TextView
            android:id="@+id/premium_description3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/space"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="We hope you like it."
            android:textColor="@color/itemDeviceOnline"
            android:textStyle="bold" />
    </RelativeLayout>
</RelativeLayout>